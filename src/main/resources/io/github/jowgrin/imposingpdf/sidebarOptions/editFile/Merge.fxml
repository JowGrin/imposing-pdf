<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar-root" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.jowgrin.imposingpdf.sidebarOptions.editFile.MergeFilesController">
    
    <Label styleClass="sidebar-title" text="Merge Files" />
    <Separator />
   <VBox styleClass="sidebar-vbox">
      <children>
           <Label styleClass="sidebar-subtitle" text="Select from opened documents:" />
         <HBox styleClass="sidebar-hbox">
            <children>
               <ComboBox fx:id="chooseFileComboBox" maxWidth="1.7976931348623157E308" onMouseClicked="#pressedChooseFile" promptText="Choose active file..." styleClass="sidebar-button" HBox.hgrow="ALWAYS" />
               <Button maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#pressedChoose" styleClass="sidebar-button" text="Choose" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
      </children>
   </VBox>
    
    <VBox styleClass="sidebar-vbox">
      <Label styleClass="sidebar-subtitle" text="open from your computer" />
      <Button mnemonicParsing="false" onAction="#pressedOpenLocalFile" styleClass="sidebar-button" text="Add files" />
    </VBox>
   <VBox styleClass="sidebar-vbox">
      <children>
         <Label styleClass="sidebar-subtitle" text="Files to Merge (Order Matters):">
         </Label>
         <HBox alignment="TOP_LEFT" styleClass="sidebar-hbox">
            <children>
               <ListView fx:id="mergeFilesListView" prefHeight="130.0" prefWidth="180.0" />
               <VBox alignment="TOP_CENTER" spacing="5.0" styleClass="sidebar-vbox">
                  <children>
                     <Button minWidth="35.0" mnemonicParsing="false" onAction="#moveUp" styleClass="sidebar-button" text="▲" />
                     <Button minWidth="35.0" mnemonicParsing="false" onAction="#moveDown" styleClass="sidebar-button" text="▼" />
                     <Button minWidth="35.0" mnemonicParsing="false" onAction="#removeMergeItem" style="-fx-text-fill: red;" styleClass="sidebar-button" text="X" />
                  </children>
               </VBox>
            </children>
         </HBox>
      </children>
   </VBox>
   <CheckBox fx:id="reorderCheckBox" mnemonicParsing="false" text="Reorder the page" />
    
    <Separator />
    
    <HBox alignment="CENTER_RIGHT" styleClass="sidebar-hbox">
        <Button onAction="#pressedCancel" styleClass="sidebar-button-cancel" text="Cancel" />

		<Button onAction="#pressedMerge" styleClass="sidebar-button-OK" text="Merge" />
    </HBox>

</VBox>
