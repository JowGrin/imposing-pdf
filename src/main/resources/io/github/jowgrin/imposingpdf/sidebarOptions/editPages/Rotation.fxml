<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="250.0" styleClass="sidebar-root" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.jowgrin.imposingpdf.sidebarOptions.editPages.RotationPagesController">
    
    <Label styleClass="sidebar-title" text="Rotate Pages" />
    <Separator />
   <VBox styleClass="sidebar-vbox">
      <children>
           <Label styleClass="sidebar-subtitle" text="Choose File" />
         <ComboBox fx:id="chooseFileComboBox" maxWidth="1.7976931348623157E308" onMouseClicked="#pressedChooseFile" promptText="Choose active file..." styleClass="sidebar-button" />
      </children>
   </VBox>
   <Separator prefWidth="200.0" />
   <HBox alignment="CENTER_LEFT" styleClass="sidebar-hbox">
      <children>
         <Label styleClass="sidebar-subtitle" text="Series of:" />
         <Spinner fx:id="seriesOf" editable="true" initialValue="4" max="999" min="1" styleClass="sidebar-spinner" />
      </children>
   </HBox>
   <VBox styleClass="sidebar-vbox">
      <children>
         <Label styleClass="sidebar-subtitle" text="Rotate specific:" />
         <TextField fx:id="orderSeries" promptText="e.g. for series of 4: 1,4" styleClass="te">
            <VBox.margin>
               <Insets left="8.0" />
            </VBox.margin></TextField>
      </children>
   </VBox>
   <VBox styleClass="sidebar-vbox">
      <children>
         <Label styleClass="sidebar-subtitle" text="Rotation:" />
         <RadioButton fx:id="radioButton90" mnemonicParsing="false" text="Landscape / 90°">
            <toggleGroup>
               <ToggleGroup fx:id="rotation" />
            </toggleGroup></RadioButton>
         <RadioButton fx:id="radioButton180" mnemonicParsing="false" selected="true" text="Portrait Upside Down / 180°" toggleGroup="$rotation" />
         <RadioButton fx:id="radioButton270" mnemonicParsing="false" text="Landscape Upside Down / 270°" toggleGroup="$rotation" />
      </children>
   </VBox>
    
    <Separator />
    
    <HBox alignment="CENTER_RIGHT" styleClass="sidebar-hbox">
        <Button onAction="#pressedCancel" styleClass="sidebar-button-cancel" text="Cancel" />

		<Button onAction="#pressedRotate" styleClass="sidebar-button-OK" text="Rotate" />
    </HBox>

</VBox>
