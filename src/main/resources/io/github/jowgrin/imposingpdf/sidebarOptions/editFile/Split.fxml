<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox styleClass="sidebar-root" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.jowgrin.imposingpdf.sidebarOptions.editFile.SplitFileController">
    
    <Label styleClass="sidebar-title" text="Split File" />
    <Separator />
   <VBox styleClass="sidebar-vbox">
      <children>
           <Label styleClass="sidebar-subtitle" text="Select from Opened Documents:" />
         <HBox styleClass="sidebar-hbox">
            <children>
               <ComboBox fx:id="chooseFileComboBox" onAction="#choosedActiveFile" onMouseClicked="#pressedChooseFile" promptText="Choose active file..." styleClass="sidebar-button" />
            </children>
         </HBox>
      </children>
   </VBox>
    
    <VBox styleClass="sidebar-vbox">
      <Label styleClass="sidebar-subtitle" text="Open from Your Computer" />
      <Button mnemonicParsing="false" onAction="#pressedOpenLocalFile" styleClass="sidebar-button" text="Open file" />
    </VBox>
   <HBox alignment="CENTER_LEFT" styleClass="sidebar-hbox">
      <children>
         <Label minHeight="-Infinity" minWidth="-Infinity" styleClass="sidebar-subtitle" text="File to Split:">
         </Label>
         <Text fx:id="nameFileText" fill="#0ec448" strokeType="OUTSIDE" strokeWidth="0.0" text="no file choosed" />
      </children>
   </HBox>
   <VBox styleClass="sidebar-vbox">
      <children>
         <HBox alignment="CENTER_LEFT" spacing="5.0">
            <children>
               <RadioButton fx:id="extractRangeButton" mnemonicParsing="false" onAction="#pressedExtractRange" selected="true" text="Extract ranges:">
                  <toggleGroup>
                     <ToggleGroup fx:id="typeSplit" />
                  </toggleGroup></RadioButton>
               <TextField fx:id="rangePageTextField" prefHeight="26.0" prefWidth="105.0" promptText="e.g. 1-5, 8, 9-15" />
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT">
            <children>
               <RadioButton fx:id="cutToButton" mnemonicParsing="false" onAction="#pressedCutTo" text="Cut to: " toggleGroup="$typeSplit" />
               <Spinner fx:id="cutTo" disable="true" editable="true" initialValue="2" max="100" min="2" prefHeight="26.0" prefWidth="73.0" />
            </children>
         </HBox>
      </children>
   </VBox>
    
    <Separator />
    
    <HBox alignment="CENTER_RIGHT" styleClass="sidebar-hbox">
        <Button onAction="#pressedCancel" styleClass="sidebar-button-cancel" text="Cancel" />

		<Button onAction="#pressedSplit" styleClass="sidebar-button-OK" text="Split" />
    </HBox>

</VBox>
