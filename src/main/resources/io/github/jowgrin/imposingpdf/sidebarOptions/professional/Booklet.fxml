<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar-root" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.jowgrin.imposingpdf.sidebarOptions.professional.BookletController">
    
    <Label styleClass="sidebar-title" text="Create booklet" />
    <Separator />
   <VBox styleClass="sidebar-vbox">
      <children>
           <Label styleClass="sidebar-subtitle" text="Choose File" />
         <ComboBox fx:id="chooseFileComboBox" maxWidth="1.7976931348623157E308" onMouseClicked="#pressedChooseFile" promptText="Choose active file..." styleClass="sidebar-button" />
      </children>
   </VBox>
   <VBox styleClass="sidebar-vbox">
      <children>
         <Label styleClass="sidebar-subtitle" text="Type:" />
         <ComboBox fx:id="typeLanguage" prefWidth="150.0" promptText="LTR (English)" styleClass="sidebar-comboBox" />
      </children>
   </VBox>
   <HBox alignment="CENTER_LEFT" prefHeight="13.0" prefWidth="220.0" styleClass="sidebar-hbox" />
    
    <Separator />
    
    <HBox alignment="CENTER_RIGHT" styleClass="sidebar-hbox">
        <Button onAction="#pressedCancel" styleClass="sidebar-button-cancel" text="Cancel" />

		<Button onAction="#pressedCreate" styleClass="sidebar-button-OK" text="Create" />
    </HBox>

</VBox>
